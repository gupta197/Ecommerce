# Environment configuration for @ecommerce/api
# Documents variable names only — never commit real values here.
# In production, inject these directly (container/orchestrator env vars) —
# no .env file is required or expected in production.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins for CORS.
# REQUIRED in production — startup fails fast if missing or set to "*".
# In development, defaults to the local web/admin Vite dev ports if unset
# (adjust to match your actual local ports).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

LOG_LEVEL=info

# In-memory rate limiting — single instance only, not coordinated across
# multiple instances. See src/middleware/rate-limit.ts for details.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

SHUTDOWN_TIMEOUT_MS=10000

# MongoDB connection (DB-001). In production, MONGODB_URI must use
# mongodb+srv:// or include tls=true/ssl=true, and must not point at
# localhost/127.0.0.1 — startup fails fast otherwise. See src/db/README.md.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ecommerce_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_QUERY_TIMEOUT_MS=10000
MONGODB_INITIAL_CONNECT_RETRIES=5
MONGODB_INITIAL_CONNECT_RETRY_DELAY_MS=2000

# Auth, payment and storage variables are added by the tasks that introduce
# those integrations (SEC-001 and later).
