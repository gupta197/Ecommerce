# Environment configuration for @ecommerce/api
# Documents variable names only — never commit real values here.
# In production, inject these directly (container/orchestrator env vars) —
# no .env file is required or expected in production.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins for CORS.
# REQUIRED in production — startup fails fast if missing or set to "*".
# In development, defaults to the local web/admin Vite dev ports if unset
# (adjust to match your actual local ports).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

LOG_LEVEL=info

# In-memory rate limiting — single instance only, not coordinated across
# multiple instances. See src/middleware/rate-limit.ts for details.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

SHUTDOWN_TIMEOUT_MS=10000

# MongoDB connection (DB-001). In production, MONGODB_URI must use
# mongodb+srv:// or include tls=true/ssl=true, and must not point at
# localhost/127.0.0.1 — startup fails fast otherwise. See src/db/README.md.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ecommerce_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_QUERY_TIMEOUT_MS=10000
MONGODB_INITIAL_CONNECT_RETRIES=5
MONGODB_INITIAL_CONNECT_RETRY_DELAY_MS=2000

# Authentication (SEC-001). JWT_ACCESS_TOKEN_SECRET must be a real random
# secret of at least 32 characters in every environment — generate one with
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
JWT_ACCESS_TOKEN_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long

# Access token: short-lived, stateless-verified (15 min default).
ACCESS_TOKEN_TTL_MS=900000

# Refresh token: sliding idle expiry (30 days default), bounded by the
# absolute family lifetime below — whichever is sooner wins. No indefinitely
# renewable session.
REFRESH_TOKEN_TTL_MS=2592000000
ABSOLUTE_SESSION_LIFETIME_MS=7776000000

# Login failure handling: progressive per-account delay, never a hard lock
# (a hard lock would let an attacker deliberately lock out a victim who
# knows/guesses their email). First LOGIN_GRACE_ATTEMPTS failures cost
# nothing beyond the rate limit below; delay then doubles from
# LOGIN_BASE_DELAY_MS per additional failure, capped at LOGIN_MAX_DELAY_MS.
LOGIN_GRACE_ATTEMPTS=3
LOGIN_BASE_DELAY_MS=1000
LOGIN_MAX_DELAY_MS=900000

# Stricter rate limit applied specifically to /auth/login and /auth/register,
# on top of the generic API-wide limit above. Reuses the same in-memory
# limiter factory — not Redis-backed yet, same caveat as RATE_LIMIT_* above.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Payment and storage variables are added by the tasks that introduce those
# integrations (SEC-002 and later).
